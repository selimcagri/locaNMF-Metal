from locanmf import LocaNMF, DEFAULT_DEVICE
import torch

# pick up the default device (either 'cpu', 'cuda' or 'mps')
device = DEFAULT_DEVICE

# synchronize before/after heavy work if on GPU
if device == "cuda":
    torch.cuda.synchronize()
elif device == "mps":
    torch.mps.synchronize()

# … your simulation or model code here …
model = LocaNMF(device=device)
model.run_simulation()

# make sure all ops have finished and free up memory
if device == "cuda":
    torch.cuda.synchronize()
    torch.cuda.empty_cache()
elif device == "mps":
    torch.mps.synchronize()
    torch.mps.empty_cache()
